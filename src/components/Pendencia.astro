---
/**
 * Marcador de lacuna.
 *
 * A regra editorial do projeto é que uma página nunca inventa: onde falta
 * documento da diretoria, a página diz que falta, diz o que falta e diz quem
 * destrava. Isso vale tanto para a diretoria lendo o rascunho quanto para o
 * visitante — um site institucional que admite uma lacuna é mais confiável do
 * que um que a preenche com frase genérica.
 *
 * Visualmente é o oposto de um alerta: fio fino, sem cor de estado, sem ícone.
 * A informação em volta é que importa; isto é uma nota de rodapé com moldura.
 */
interface Props {
  /** O que falta, em uma frase. */
  titulo?: string;
  class?: string;
}

const { titulo = 'A confirmar antes de publicar.', class: classe = '' } = Astro.props;
---

<p class:list={['medida border border-papel-borda px-5 py-4 text-sm leading-relaxed text-tinta-suave', classe]}>
  <strong class="font-medium text-tinta">{titulo}</strong>{' '}<slot />
</p>
