---
import Seta from '~/components/Seta.astro';

/**
 * Visualizador em tela cheia para as galerias.
 *
 * Usa o <dialog> nativo em vez de uma div com position:fixed. O elemento
 * traz de graça o que costuma ser esquecido numa implementação manual:
 * prender o foco dentro do modal, devolver o foco ao elemento que abriu
 * quando fecha, tornar o resto da página inerte para leitores de tela, e
 * fechar no Esc.
 *
 * A navegação é por grupo: cada seção da galeria é um conjunto próprio, para
 * que avançar a partir da última foto dos corais não caia no congresso.
 * Gatilhos são <button data-lightbox> com data-grupo, data-full e data-legenda.
 */
---

<dialog
  id="lightbox"
  aria-label="Visualizador de fotografias"
  class="fixed inset-0 m-0 h-full max-h-full w-full max-w-full bg-transparent p-0 backdrop:bg-tinta/95"
>
  <div class="relative flex h-full w-full flex-col bg-tinta/95">
    <div class="flex items-center justify-between gap-6 px-4 py-4 sm:px-8">
      <p class="text-sm text-papel/60" data-lightbox-contador aria-live="polite"></p>

      <button
        type="button"
        data-lightbox-fechar
        class="grid size-11 place-items-center border border-papel/25 text-papel transition-colors hover:border-papel"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
        <span class="sr-only">Fechar</span>
      </button>
    </div>

    <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 sm:px-20">
      <img
        data-lightbox-imagem
        alt=""
        class="max-h-full max-w-full object-contain"
      />

      {/* Setas laterais só a partir de sm. Em tela estreita elas cairiam em
          cima da fotografia — o respiro lateral não comporta um botão de 48px
          de cada lado —, então lá os controles vão para a barra de baixo. */}
      <button
        type="button"
        data-lightbox-anterior
        class="absolute left-6 hidden size-12 place-items-center border border-papel/25 bg-tinta/60 text-papel transition-colors hover:border-papel sm:grid"
      >
        <Seta sentido="esquerda" tamanho={22} />
        <span class="sr-only">Fotografia anterior</span>
      </button>

      <button
        type="button"
        data-lightbox-proximo
        class="absolute right-6 hidden size-12 place-items-center border border-papel/25 bg-tinta/60 text-papel transition-colors hover:border-papel sm:grid"
      >
        <Seta tamanho={22} />
        <span class="sr-only">Próxima fotografia</span>
      </button>
    </div>

    <div class="px-4 py-5 sm:px-8">
      <p class="text-center text-sm text-papel/70" data-lightbox-legenda></p>

      <div class="mt-5 flex justify-center gap-3 sm:hidden">
        <button
          type="button"
          data-lightbox-anterior
          class="grid size-12 place-items-center border border-papel/25 text-papel"
        >
          <Seta sentido="esquerda" tamanho={22} />
          <span class="sr-only">Fotografia anterior</span>
        </button>
        <button
          type="button"
          data-lightbox-proximo
          class="grid size-12 place-items-center border border-papel/25 text-papel"
        >
          <Seta tamanho={22} />
          <span class="sr-only">Próxima fotografia</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('#lightbox');
  const imagem = document.querySelector<HTMLImageElement>('[data-lightbox-imagem]');
  const legenda = document.querySelector<HTMLElement>('[data-lightbox-legenda]');
  const contador = document.querySelector<HTMLElement>('[data-lightbox-contador]');
  /* Há dois conjuntos de setas — laterais no desktop, rodapé no celular —,
     por isso querySelectorAll: com querySelector, o segundo par ficaria mudo. */
  const btsAnterior = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-anterior]')];
  const btsProximo = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-proximo]')];
  const btFechar = document.querySelector<HTMLButtonElement>('[data-lightbox-fechar]');

  const gatilhos = [...document.querySelectorAll<HTMLElement>('[data-lightbox]')];

  if (dialogo && imagem && legenda && contador && btsAnterior.length && btFechar) {
    /** Fotos agrupadas por seção, na ordem em que aparecem na página. */
    const grupos = new Map<string, HTMLElement[]>();
    for (const g of gatilhos) {
      const nome = g.dataset.grupo ?? 'padrao';
      if (!grupos.has(nome)) grupos.set(nome, []);
      grupos.get(nome)!.push(g);
    }

    let atuais: HTMLElement[] = [];
    let indice = 0;

    const mostrar = (i: number) => {
      const total = atuais.length;
      // Circular: da última volta para a primeira. Num conjunto fechado de
      // fotos isso é menos frustrante que um botão que morre no fim.
      indice = (i + total) % total;

      const alvo = atuais[indice]!;
      imagem.src = alvo.dataset.full ?? '';
      imagem.alt = alvo.dataset.legenda ?? '';
      legenda.textContent = alvo.dataset.legenda ?? '';
      contador.textContent = `${indice + 1} de ${total}`;

      // Com uma foto só não há para onde navegar.
      const soUma = total < 2;
      for (const b of [...btsAnterior, ...btsProximo]) b.hidden = soUma;
    };

    const abrir = (gatilho: HTMLElement) => {
      const nome = gatilho.dataset.grupo ?? 'padrao';
      atuais = grupos.get(nome) ?? [];
      mostrar(atuais.indexOf(gatilho));
      dialogo.showModal();
    };

    for (const g of gatilhos) g.addEventListener('click', () => abrir(g));

    for (const b of btsAnterior) b.addEventListener('click', () => mostrar(indice - 1));
    for (const b of btsProximo) b.addEventListener('click', () => mostrar(indice + 1));
    btFechar.addEventListener('click', () => dialogo.close());

    // Clicar no fundo fecha. O <dialog> não distingue fundo de conteúdo, então
    // o alvo do clique ser o próprio dialogo é o que identifica a área externa.
    dialogo.addEventListener('click', (e) => {
      if (e.target === dialogo) dialogo.close();
    });

    // Deslizar o dedo na foto navega, como em qualquer galeria de celular.
    // Só gesto predominantemente horizontal e de pelo menos 40px conta, para
    // não confundir com toque ou com rolagem vertical.
    let inicioX = 0;
    let inicioY = 0;
    imagem.parentElement!.addEventListener(
      'touchstart',
      (e) => {
        inicioX = e.touches[0]!.clientX;
        inicioY = e.touches[0]!.clientY;
      },
      { passive: true }
    );
    imagem.parentElement!.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0]!.clientX - inicioX;
      const dy = e.changedTouches[0]!.clientY - inicioY;
      if (atuais.length > 1 && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        mostrar(dx < 0 ? indice + 1 : indice - 1);
      }
    });

    dialogo.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        mostrar(indice + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        mostrar(indice - 1);
      }
    });
  }
</script>

<style>
  /* O <dialog> nativo não anima por padrão porque alterna display. Estas
     regras dão a ele uma entrada curta sem tirar o comportamento nativo. */
  dialog[open] {
    animation: lightbox-entra 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  dialog[open]::backdrop {
    animation: lightbox-fundo 220ms ease-out;
  }

  @keyframes lightbox-entra {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  @keyframes lightbox-fundo {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog[open],
    dialog[open]::backdrop {
      animation: none;
    }
  }
</style>
