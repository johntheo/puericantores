---
/**
 * Conjunto de ícones do site.
 *
 * Dois grupos com regras diferentes, de propósito:
 *
 *  - utilitários (site, e-mail) são desenhados com traço de 1.5, para casar
 *    com a Seta e manter uma espessura só em toda a interface;
 *  - marcas (Instagram, Facebook, X, YouTube) são preenchidas, porque um
 *    logotipo redesenhado em contorno deixa de ser reconhecível — e
 *    reconhecimento é a única função que ele tem aqui.
 *
 * Nada de emoji nem glifo de fonte: eles herdam métrica e peso do texto e
 * nunca alinham com o resto.
 */
export type NomeIcone = 'site' | 'email' | 'instagram' | 'facebook' | 'twitter' | 'youtube';

interface Props {
  nome: NomeIcone;
  tamanho?: number;
  class?: string;
}

const { nome, tamanho = 20, class: classe = '' } = Astro.props;

const traçado = new Set<NomeIcone>(['site', 'email']);
const eTraco = traçado.has(nome);

const rotulos: Record<NomeIcone, string> = {
  site: 'Site',
  email: 'E-mail',
  instagram: 'Instagram',
  facebook: 'Facebook',
  twitter: 'X',
  youtube: 'YouTube',
};
---

<svg
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill={eTraco ? 'none' : 'currentColor'}
  stroke={eTraco ? 'currentColor' : 'none'}
  stroke-width={eTraco ? 1.5 : undefined}
  stroke-linecap={eTraco ? 'round' : undefined}
  stroke-linejoin={eTraco ? 'round' : undefined}
  class:list={['inline-block shrink-0', classe]}
  role="img"
  aria-label={rotulos[nome]}
>
  {
    nome === 'site' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3c2.5 2.7 3.7 5.7 3.7 9s-1.2 6.3-3.7 9c-2.5-2.7-3.7-5.7-3.7-9S9.5 5.7 12 3Z" />
      </>
    )
  }

  {
    nome === 'email' && (
      <>
        <rect x="3" y="5.5" width="18" height="13" rx="1.5" />
        <path d="m3.5 6.5 8.5 6 8.5-6" />
      </>
    )
  }

  {
    nome === 'instagram' && (
      <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.8.07-1 .05-1.6.22-1.9.36-.5.2-.8.4-1.2.7-.3.4-.5.7-.7 1.2-.1.3-.3.9-.4 1.9C3 9.5 3 9.9 3 13s0 3.5.07 4.8c.05 1 .22 1.6.36 1.9.2.5.4.8.7 1.2.4.3.7.5 1.2.7.3.1.9.3 1.9.4 1.3.06 1.7.07 4.8.07s3.5 0 4.8-.07c1-.05 1.6-.22 1.9-.36.5-.2.8-.4 1.2-.7.3-.4.5-.7.7-1.2.1-.3.3-.9.4-1.9.06-1.3.07-1.7.07-4.8s0-3.5-.07-4.8c-.05-1-.22-1.6-.36-1.9a3.2 3.2 0 0 0-.7-1.2 3.2 3.2 0 0 0-1.2-.7c-.3-.1-.9-.3-1.9-.4C15.5 4 15.1 4 12 4Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 8a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2Zm6.3-8.2a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0Z" />
    )
  }

  {
    nome === 'facebook' && (
      <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z" />
    )
  }

  {
    nome === 'twitter' && (
      <path d="M17.5 3h3.1l-6.8 7.8L21.8 21h-6.2l-4.9-6.4L5.1 21H2l7.3-8.3L2.5 3h6.4l4.4 5.8L17.5 3Zm-1.1 16.1h1.7L7.7 4.8H5.9l10.5 14.3Z" />
    )
  }

  {
    nome === 'youtube' && (
      <path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15.1V8.9l5.2 3.1-5.2 3.1Z" />
    )
  }
</svg>
