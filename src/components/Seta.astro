---
/**
 * Seta desenhada.
 *
 * Substitui o `→` que estava no lugar. Glifo unicode como ícone herda a
 * espessura, o alinhamento vertical e a métrica da fonte de texto, então
 * nunca casa com o traço do resto da interface e pula de posição quando a
 * fonte troca. Aqui o traço acompanha a cor do texto e tem espessura própria.
 */
interface Props {
  /** Direção da ponta. */
  sentido?: 'direita' | 'esquerda';
  tamanho?: number;
  class?: string;
}

const { sentido = 'direita', tamanho = 20, class: classe = '' } = Astro.props;
---

<svg
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['inline-block shrink-0', sentido === 'esquerda' && 'rotate-180', classe]}
>
  <path d="M4 12h15" />
  <path d="M13 6l6 6-6 6" />
</svg>
