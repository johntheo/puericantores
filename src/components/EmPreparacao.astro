---
import { rota } from '~/config/site';
/**
 * Página ainda não construída.
 *
 * A fase 1 entrega home e páginas de coral. As demais rotas existem para que
 * nada quebre quando a diretoria navegar pelo protótipo — um 404 durante a
 * apresentação passa impressão pior que uma página assumidamente em obra.
 */
import Base from '~/layouts/Base.astro';

interface Props {
  titulo: string;
  descricao: string;
  /** O que essa página vai conter quando ficar pronta. */
  conteudo: string[];
  /** O que a federação precisa entregar para destravá-la. */
  depende?: string;
}

const { titulo, descricao, conteudo, depende } = Astro.props;
---

<Base titulo={titulo} descricao={descricao}>
  <section class="quadro flex min-h-[70svh] flex-col justify-center py-24">
    <h1 class="text-(length:--text-titulo)">{titulo}</h1>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">{descricao}</p>

    <span class="fio mt-14 max-w-xl" aria-hidden="true"></span>

    <div class="mt-8 max-w-xl">
      <p class="text-sm text-tinta-tenue">Esta página vai reunir</p>

      <ul class="mt-4 space-y-2">
        {conteudo.map((item) => <li class="text-tinta-suave">{item}</li>)}
      </ul>

      {
        depende && (
          <p class="mt-8 border border-papel-borda px-5 py-4 text-sm text-tinta-suave">
            <strong class="font-medium text-tinta">Depende de:</strong> {depende}
          </p>
        )
      }
    </div>

    <p class="mt-12">
      <a
        href={rota("/corais")}
        class="border-b border-acento pb-1 transition-colors hover:text-acento-profundo"
      >
        Enquanto isso, conheça os corais
      </a>
    </p>
  </section>
</Base>
