---
import { site, navegacao, rota } from '~/config/site';
import Brasao from '~/components/Brasao.astro';
import MenuMobile from '~/components/MenuMobile.astro';

interface Props {
  /** Sobre foto de tela cheia o cabeçalho fica branco e sem fundo. */
  sobreposto?: boolean;
}

const { sobreposto = false } = Astro.props;
const atual = Astro.url.pathname;
---

<header
  class:list={[
    'top-0 z-40 w-full',
    /* O véu fica num pseudo-elemento: `backdrop-filter` no próprio header vira
       bloco de contenção dos filhos `fixed`, e o painel do menu mobile
       encolhia para a altura do cabeçalho em toda página sem foto. */
    sobreposto
      ? 'absolute text-papel'
      : 'sticky text-tinta before:absolute before:inset-0 before:-z-10 before:bg-papel/85 before:backdrop-blur-sm',
  ]}
>
  <div class="quadro flex items-center justify-between gap-6 py-5">
    <a href={rota("/")} class="flex items-center gap-3" aria-label={`${site.assinatura} — início`}>
      <Brasao tamanho={44} titulo="" />
      <span class="font-display text-lg leading-none tracking-tight sm:text-xl">
        {site.assinatura}
      </span>
    </a>

    <nav aria-label="Navegação principal" class="hidden items-center gap-8 md:flex">
      {
        navegacao.map(({ href, rotulo }) => {
          const ativo = atual === href || atual.startsWith(`${href}/`);
          return (
            <a
              href={rota(href)}
              aria-current={ativo ? 'page' : undefined}
              class:list={[
                'text-sm transition-opacity hover:opacity-60',
                ativo && 'underline decoration-acento decoration-2 underline-offset-8',
              ]}
            >
              {rotulo}
            </a>
          );
        })
      }
    </nav>

    <MenuMobile sobreposto={sobreposto} />
  </div>
</header>
