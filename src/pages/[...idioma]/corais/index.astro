---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import CardCoral from '~/components/CardCoral.astro';
import { textos } from '~/i18n';
import { caminhosIdioma } from '~/i18n/idiomas';

export const getStaticPaths = caminhosIdioma;

const { t } = textos(Astro.currentLocale);

const corais = (await getCollection('corais')).sort(
  (a, b) =>
    (a.data.fundacao ?? Number.POSITIVE_INFINITY) - (b.data.fundacao ?? Number.POSITIVE_INFINITY)
);

const ufs = [...new Set(corais.map((c) => c.data.uf))].sort();
---

<Base
  titulo={t.corais.titulo}
  descricao={t.corais.descricao(corais.length, ufs.length)}
>
  <section class="quadro pt-20 pb-14 sm:pt-28">
    <h1 class="text-(length:--text-titulo)">{t.corais.h1}</h1>

    <p class="mt-5 text-tinta-tenue">{t.corais.resumo(corais.length, ufs.length)}</p>

    {/* Filtro puramente client-side sobre um grid já renderizado: nenhum
        conteúdo depende de JS para existir, só a ocultação. */}
    <div class="mt-12 flex flex-wrap gap-2" role="group"
      aria-label={t.corais.filtrar}
      id="filtro"
      data-um={t.corais.contagemUm}
      data-varios={t.corais.contagemVarios}
    >
      <button
        type="button"
        data-uf="todos"
        aria-pressed="true"
        class="filtro-btn border border-tinta bg-tinta px-4 py-2 text-sm text-papel"
      >
        {t.corais.todos}
      </button>
      {
        ufs.map((uf) => (
          <button
            type="button"
            data-uf={uf}
            aria-pressed="false"
            class="filtro-btn border border-papel-borda px-4 py-2 text-sm transition-colors hover:border-tinta"
          >
            {uf}
          </button>
        ))
      }
    </div>
  </section>

  <section class="quadro pb-(--spacing-secao)">
    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" id="grade">
      {
        corais.map((coral) => (
          <div data-uf={coral.data.uf}>
            <CardCoral coral={coral} />
          </div>
        ))
      }
    </div>

    <p class="mt-14 text-sm text-tinta-tenue" role="status" id="contagem"></p>
  </section>
</Base>

<script>
  const filtro = document.querySelector<HTMLElement>('#filtro');
  const grade = document.querySelector<HTMLElement>('#grade');
  const contagem = document.querySelector<HTMLElement>('#contagem');

  if (filtro && grade && contagem) {
    const botoes = [...filtro.querySelectorAll<HTMLButtonElement>('.filtro-btn')];
    const itens = [...grade.querySelectorAll<HTMLElement>('[data-uf]')];

    const aplicar = (uf: string) => {
      let visiveis = 0;

      for (const item of itens) {
        const mostra = uf === 'todos' || item.dataset.uf === uf;
        item.hidden = !mostra;
        if (mostra) visiveis++;
      }

      for (const b of botoes) {
        const ativo = b.dataset.uf === uf;
        b.setAttribute('aria-pressed', String(ativo));
        b.classList.toggle('bg-tinta', ativo);
        b.classList.toggle('text-papel', ativo);
        b.classList.toggle('border-tinta', ativo);
        b.classList.toggle('border-papel-borda', !ativo);
      }

      contagem.textContent =
        uf === 'todos'
          ? ''
          : (visiveis === 1 ? filtro.dataset.um : filtro.dataset.varios)!
              .replace('{n}', String(visiveis))
              .replace('{uf}', uf);
    };

    for (const b of botoes) {
      b.addEventListener('click', () => aplicar(b.dataset.uf ?? 'todos'));
    }
  }
</script>
