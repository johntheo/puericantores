---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Brasao from '~/components/Brasao.astro';
import Linhas from '~/components/Linhas.astro';
import { textos, numero, data } from '~/i18n';
import { caminhosIdioma } from '~/i18n/idiomas';
import { site, rota } from '~/config/site';
import {
  internacional,
  diretoria,
  congressosNacionais,
  congressosInternacionais,
  congressosRegionais,
  congressosFuturos,
} from '~/config/federacao';

export const getStaticPaths = caminhosIdioma;

const { idioma, t } = textos(Astro.currentLocale);
const f = t.federacao;
const r = (caminho: string) => rota(caminho, idioma);

/** Cidade brasileira fica como está; lugar estrangeiro vem traduzido. */
const lugar = (local: string) => (f.lugares as Record<string, string>)[local] ?? local;

const corais = await getCollection('corais');

/* Calculados da coleção, como na home: número escrito à mão em página
   institucional envelhece na primeira filiação nova e ninguém percebe. */
const totalCorais = corais.length;
const estados = new Set(corais.map((c) => c.data.uf)).size;
const fundacoesConhecidas = corais.flatMap((c) => (c.data.fundacao ? [c.data.fundacao] : []));
const maisAntigo = Math.min(...fundacoesConhecidas);
const maisNovo = Math.max(...fundacoesConhecidas);

---

<Base
  titulo={f.titulo}
  descricao={f.descricao(totalCorais, estados)}
>
  <section class="quadro pt-20 pb-14 sm:pt-28">
    <h1 class="text-(length:--text-titulo)">{f.titulo}</h1>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">
      {f.abertura(site.razaoSocial)}
    </p>
  </section>

  {/* ── O QUE SIGNIFICA ─────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">
        <Linhas linhas={f.significa.titulo} />
      </h2>

      <div class="medida space-y-6 text-lg leading-relaxed text-tinta-suave">
        {f.significa.paragrafos({ maisAntigo, maisNovo }).map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {/* ── NO MUNDO ────────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">
        <Linhas linhas={f.mundo.titulo} />
      </h2>

      <div>
        <div class="medida space-y-6 text-lg leading-relaxed text-tinta-suave">
          <p>
            {f.mundo.p1.antes} <i lang="it">{f.mundo.p1.documento}</i>{f.mundo.p1.meio(internacional.fundador)}<i
              lang="fr">{f.mundo.p1.nomeFrances}</i
            >{f.mundo.p1.depois}
          </p>
          <p>{f.mundo.p2(internacional.fundacao)}</p>
          <p>
            {
              f.mundo.p3({
                estatuto: internacional.estatutoChancelado,
                paises: internacional.paises,
                cantores: numero(internacional.cantores, idioma),
              })
            }
          </p>
        </div>

        <p class="mt-8 text-sm">
          <a
            href={internacional.site}
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-acento pb-1 transition-colors hover:text-acento-profundo"
          >
            {f.mundo.link}
          </a>
        </p>
      </div>
    </div>
  </section>

  {/* ── NO BRASIL ───────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">{f.brasil.titulo}</h2>

      <div>
        <div class="medida space-y-6 text-lg leading-relaxed text-tinta-suave">
          <p>{f.brasil.p1(site.razaoSocial)}</p>
          <p>{f.brasil.p2(totalCorais, estados)}</p>
          <p>{f.brasil.p3(diretoria.executiva[0].nome)}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── CONGRESSOS ──────────────────────────────────────────────────────────
      Relação enviada pela federação em novembro de 2026, com as fontes
      anotadas em src/config/federacao.ts. */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">{f.congressos.titulo}</h2>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">
      {f.congressos.texto}
    </p>

    <div class="mt-14 grid gap-14 md:grid-cols-3 md:gap-12">
      <div>
        <h3 class="text-xl">{f.congressos.nacionais}</h3>

        <ul class="mt-6">
          {
            congressosNacionais.map((c) => (
              <li class="border-t border-papel-borda py-5">
                <p class="flex flex-wrap items-baseline gap-x-4">
                  <span data-numerico class="font-display text-3xl leading-none">{c.ano}</span>
                  <span class="text-tinta-suave">{f.congressos.nacional(c.edicao)}</span>
                </p>
                <p class="mt-2 text-sm text-tinta-suave">{lugar(c.local)}</p>
                {c.nota && (
                  <p class="mt-2 text-sm text-tinta-tenue">
                    {c.futuro && <span class="text-acento-profundo">{f.congressos.aindaPorVir} </span>}
                    {f.notas[c.nota]}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xl">{f.congressos.internacionais}</h3>

        <ul class="mt-6">
          {
            congressosInternacionais.map((c) => (
              <li class="border-t border-papel-borda py-5">
                <p class="flex flex-wrap items-baseline gap-x-4">
                  <span data-numerico class="font-display text-3xl leading-none">{c.ano}</span>
                  <span class="text-tinta-suave">
                    {f.congressos.internacional(c.edicao)}
                  </span>
                </p>
                <p class="mt-2 text-sm text-tinta-suave">{lugar(c.local)}</p>
                {c.nota && <p class="mt-2 text-sm text-tinta-tenue">{f.notas[c.nota]}</p>}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xl">{f.congressos.regionais}</h3>

        <ul class="mt-6">
          {
            congressosRegionais.map((c) => (
              <li class="border-t border-papel-borda py-5">
                <p class="font-display text-3xl leading-none">{c.ano}</p>
                <p class="mt-2 text-sm text-tinta-suave">{lugar(c.local)}</p>
                {c.nota && <p class="mt-2 text-sm text-tinta-tenue">{f.notas[c.nota]}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

  </section>

  {/* ── PRÓXIMOS ENCONTROS ───────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">{f.congressos.proximos}</h2>

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        congressosFuturos.map((c) => (
          <li class="border-t border-papel-borda py-5">
            <p class="font-display text-3xl leading-none">{c.ano}</p>
            <p class="mt-2 text-lg">{lugar(c.local)}</p>
            {c.nota && <p class="mt-2 text-sm leading-relaxed text-tinta-tenue">{f.notas[c.nota]}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  {/* ── DIRETORIA ───────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">{f.diretoria.titulo}</h2>

    <p class="mt-4 text-sm text-tinta-tenue">
      {f.diretoria.mandato(data(diretoria.mandato.inicio, idioma), data(diretoria.mandato.fim, idioma))}
    </p>

    <div class="mt-10 grid gap-12 md:grid-cols-2">
      <div>
        <h3 class="text-xl">{f.diretoria.executiva}</h3>
        <ul class="mt-6 grid gap-5 sm:grid-cols-2">
          {diretoria.executiva.map((pessoa) => (
            <li>
              <p class="font-display text-2xl leading-tight">{pessoa.nome}</p>
              <p class="mt-1 text-sm text-tinta-tenue">{f.diretoria.cargos[pessoa.cargo]}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xl">{f.diretoria.conselhoFiscal}</h3>
        <p class="mt-6 text-sm uppercase tracking-[0.12em] text-tinta-tenue">{f.diretoria.titulares}</p>
        <ul class="mt-3 space-y-2">
          {diretoria.conselhoFiscal.titulares.map((nome) => <li>{nome}</li>)}
        </ul>
        <p class="mt-6 text-sm uppercase tracking-[0.12em] text-tinta-tenue">{f.diretoria.suplentes}</p>
        <ul class="mt-3 space-y-2">
          {diretoria.conselhoFiscal.suplentes.map((nome) => <li>{nome}</li>)}
        </ul>
      </div>
    </div>

  </section>

  {/* ── CHAMADAS ────────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" aria-hidden="true"></span>

    <div class="mt-10 flex flex-wrap items-center gap-10">
      <Brasao tamanho={88} titulo="" />

      <div class="flex flex-wrap gap-x-10 gap-y-4">
        <a
          href={r('/corais')}
          class="border-b border-acento pb-1 text-lg transition-colors hover:text-acento-profundo"
        >
          {f.chamadas.corais(totalCorais)}
        </a>
        <a
          href={r('/filiacao')}
          class="border-b border-transparent pb-1 text-lg text-tinta-suave transition-colors hover:border-papel-borda hover:text-tinta"
        >
          {f.chamadas.filiar}
        </a>
      </div>
    </div>
  </section>
</Base>
