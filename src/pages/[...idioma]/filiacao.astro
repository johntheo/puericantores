---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Seta from '~/components/Seta.astro';
import { site, rota } from '~/config/site';
import { escrever } from '~/config/federacao';
import Linhas from '~/components/Linhas.astro';
import { textos } from '~/i18n';
import { caminhosIdioma } from '~/i18n/idiomas';
import { internacional } from '~/config/federacao';

export const getStaticPaths = caminhosIdioma;

const { idioma, t } = textos(Astro.currentLocale);
const f = t.filiacao;

const corais = await getCollection('corais');

const totalCorais = corais.length;
const estados = new Set(corais.map((c) => c.data.uf)).size;

/* A distância entre fundar e filiar-se, medida nos próprios filiados. É o dado
   que responde à pergunta que todo coro interessado faz primeiro: "é cedo
   demais para nós?" O dado sai da coleção, não de opinião. */
const esperas = corais.flatMap((c) =>
  c.data.filiacao !== undefined && c.data.fundacao !== undefined
    ? [c.data.filiacao - c.data.fundacao]
    : []
);
const filiaramNoMesmoAno = esperas.filter((n) => n <= 0).length;
const esperaMaxima = Math.max(...esperas);

const escreverFiliacao = escrever(site.contato.email, t.emails.filiacao);

/* O retrato do que os filiados têm em comum (no dicionário) é observado nos
   coros com perfil publicado, não extraído de estatuto. A página diz isso com
   todas as letras: enquanto o documento não chega, descrever o que os coros
   têm em comum é honesto; chamar isso de "requisito" não seria. */
---

<Base
  titulo={f.titulo}
  descricao={f.descricao}
>
  <section class="quadro pt-20 pb-14 sm:pt-28">
    <h1 class="text-(length:--text-titulo)">{f.h1}</h1>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">
      {f.abertura(totalCorais, estados)}
    </p>

    {/* Federação nacional: só coros do Brasil se filiam. Dito nos três
        idiomas, porque a página em EN e ES atrai coros de fora. */}
    <p class="medida mt-6 text-sm leading-relaxed text-tinta-tenue">
      {f.soBrasil.antes}{' '}
      <a href={internacional.site} target="_blank" rel="noopener noreferrer" class="underline hover:text-acento-profundo"
        >{f.soBrasil.link}</a
      >{f.soBrasil.depois}
    </p>
  </section>

  {/* ── O QUE MUDA ──────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">
        <Linhas linhas={f.muda.titulo} />
      </h2>

      <div class="medida space-y-6 text-lg leading-relaxed text-tinta-suave">
        {f.muda.paragrafos.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {/* ── O QUE OS FILIADOS TÊM EM COMUM ──────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">{f.comum.titulo}</h2>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">
      {f.comum.texto(totalCorais)}
    </p>

    <ul class="mt-14 grid gap-px bg-papel-borda sm:grid-cols-2">
      {
        f.comum.itens.map((item) => (
          <li class="bg-papel p-8 sm:p-10">
            <h3 class="text-2xl">{item.titulo}</h3>
            <p class="mt-4 leading-relaxed text-tinta-suave">{item.texto}</p>
          </li>
        ))
      }
    </ul>

    <div class="medida mt-12 border border-papel-borda px-6 py-5 text-sm leading-relaxed text-tinta-suave">
      <strong class="font-medium text-tinta">{f.comum.regimento}</strong>{' '}
      {f.comum.regimentoTexto}
    </div>
  </section>

  {/* ── QUANDO ─────────────────────────────────────────────────────────────
      Números calculados da coleção. Existem para desarmar a objeção mais comum
      de quem pensa em se filiar: "o nosso coro é novo demais". */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">{f.cedo.titulo}</h2>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">
      {f.cedo.texto({ mesmoAno: filiaramNoMesmoAno, esperaMaxima })}
    </p>

    <p class="mt-8">
      <a
        href={rota('/corais', idioma)}
        class="group inline-flex items-center gap-3 border-b border-acento pb-1 transition-colors hover:text-acento-profundo"
      >
        {f.cedo.link}
        <Seta class="transition-transform duration-500 group-hover:translate-x-1" />
      </a>
    </p>
  </section>

  {/* ── COMO COMEÇAR ────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">{f.comecar.titulo}</h2>

      <div>
        <p class="medida text-lg leading-relaxed text-tinta-suave">
          {f.comecar.texto}
        </p>

        <p class="mt-10">
          <a
            href={escreverFiliacao}
            class="group inline-flex items-center gap-3 bg-tinta px-8 py-4 text-papel transition-colors hover:bg-acento-profundo"
          >
            {f.comecar.botao}
            <Seta class="transition-transform duration-500 group-hover:translate-x-1" />
          </a>
        </p>

        <p class="mt-6 text-sm text-tinta-tenue">
          {f.comecar.ouEscreva}{' '}
          <a href={`mailto:${site.contato.email}`} class="underline hover:text-acento-profundo">
            {site.contato.email}
          </a>. {t.comum.responde}
        </p>

        <p class="medida mt-10 text-sm leading-relaxed text-tinta-tenue">
          {f.comecar.dados}
        </p>
      </div>
    </div>
  </section>
</Base>
