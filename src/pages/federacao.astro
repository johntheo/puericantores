---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Brasao from '~/components/Brasao.astro';
import { site, rota } from '~/config/site';
import {
  internacional,
  diretoria,
  congressosNacionais,
  congressosInternacionais,
  congressosRegionais,
  congressosFuturos,
} from '~/config/federacao';

const corais = await getCollection('corais');

/* Calculados da coleção, como na home: número escrito à mão em página
   institucional envelhece na primeira filiação nova e ninguém percebe. */
const totalCorais = corais.length;
const estados = new Set(corais.map((c) => c.data.uf)).size;
const fundacoesConhecidas = corais.flatMap((c) => (c.data.fundacao ? [c.data.fundacao] : []));
const maisAntigo = Math.min(...fundacoesConhecidas);
const maisNovo = Math.max(...fundacoesConhecidas);

const numero = (n: number) => n.toLocaleString('pt-BR');
---

<Base
  titulo="A federação"
  descricao={`A Federação Nacional dos Meninos Cantores do Brasil reúne ${totalCorais} coros de meninos e meninas em ${estados} estados, dentro da Pueri Cantores internacional.`}
>
  <section class="quadro pt-20 pb-14 sm:pt-28">
    <h1 class="text-(length:--text-titulo)">A federação</h1>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">
      A {site.razaoSocial} reúne os coros de meninos e meninas do Brasil que cantam a liturgia e o
      grande repertório coral. É o braço brasileiro da Pueri Cantores, federação internacional
      reconhecida pela Santa Sé.
    </p>
  </section>

  {/* ── O QUE SIGNIFICA ─────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">
        O que é ser<br />um coro Pueri&nbsp;Cantores
      </h2>

      <div class="medida space-y-6 text-lg leading-relaxed text-tinta-suave">
        <p>
          Um coro Pueri Cantores não é um coro infantil que às vezes canta na igreja. É um coro que
          existe para a liturgia. Para isso, precisa ensinar música de verdade a crianças que em
          geral nunca tiveram acesso a ela.
        </p>
        <p>
          Os coros oferecem formação musical e serviço à liturgia. Há quem ensaie uma vez por
          semana e quem ensaie seis. Há coros mantidos por uma província franciscana e coros
          mantidos pelas famílias dos próprios cantores. O mais antigo canta desde {maisAntigo}; o
          mais novo, desde {maisNovo}. O que os aproxima é a combinação de rigor musical, formação
          humana e serviço à celebração.
        </p>
        <p>
          A federação existe para sustentar esse trabalho: reúne os coros em congressos, representa
          o Brasil na federação internacional e serve de referência para quem quer começar um coro
          novo.
        </p>
      </div>
    </div>
  </section>

  {/* ── NO MUNDO ────────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">
        Uma federação<br />pontifícia.
      </h2>

      <div>
        <div class="medida space-y-6 text-lg leading-relaxed text-tinta-suave">
          <p>
            Uma longa tradição europeia de corais de meninos cantando a liturgia ganhou forma
            institucional no início do século XX, com o motu próprio <i>Tra le sollecitudini</i>, em
            que São Pio X pedia a renovação da música na Igreja. Em resposta, Monsenhor
            {internacional.fundador} fundou em Paris, em 1907, os Pequenos Cantores da Cruz de Madeira
            (<i lang="fr">Petits Chanteurs de la Croix de Bois</i>), que cantaram pela paz em muitos
            países depois da Primeira Guerra Mundial. A Segunda Guerra interrompeu sua atividade, mas
            não os destruiu.
          </p>
          <p>
            Em julho de 1944, o arcebispo de Paris, cardeal Suhard, aprovou a fundação de uma
            organização internacional dos Pueri Cantores como “um elemento de beleza musical na
            Igreja, um trabalho de educação cristã e atividade apostólica a serviço da liturgia”. A
            data oficial de fundação é 11 de novembro de {internacional.fundacao}, quando trezentos
            meninos cantores regidos por Maillet deram o primeiro concerto na igreja de Santo
            Eustáquio, em Paris. O primeiro congresso internacional aconteceu na mesma cidade, em
            1947, com noventa coros europeus, seguido pelos de Roma, em 1949 e 1951.
          </p>
          <p>
            Em {internacional.estatutoChancelado} a Santa Sé aprovou o estatuto da federação, que
            passou a ser reconhecida como movimento eclesial, sob a jurisdição do Pontifício Conselho
            para os Leigos. As reformas do estatuto de 1995 e 2001 permitiram a entrada de meninas.
            Hoje há coros de meninos, de meninas e mistos em {internacional.paises} países de todos os
            continentes, com aproximadamente {numero(internacional.cantores)} cantores. A tarefa
            principal continua sendo cantar a liturgia, e os valores cristãos são a base da vida e
            da conduta de seus membros.
          </p>
        </div>

        <p class="mt-8 text-sm">
          <a
            href={internacional.site}
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-acento pb-1 transition-colors hover:text-acento-profundo"
          >
            Federação internacional Pueri Cantores
          </a>
        </p>
      </div>
    </div>
  </section>

  {/* ── NO BRASIL ───────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <div class="mt-10 grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-20">
      <h2 class="text-(length:--text-secao) md:sticky md:top-28 md:self-start">No Brasil</h2>

      <div>
        <div class="medida space-y-6 text-lg leading-relaxed text-tinta-suave">
          <p>
            A {site.razaoSocial} foi fundada em 1967 por Frei Leto, pelo padre José Maria
            Wisniewski e pelo maestro João Lucas Rodrigues. Seu objetivo é fomentar, entre crianças,
            adolescentes e jovens, o canto coral e a formação artístico-cultural, com foco no canto
            litúrgico. É filiada à Federação Internacional Pueri Cantores, com sede em Roma.
          </p>
          <p>
            Hoje reúne {totalCorais} coros federados de {estados} estados. A cada três anos realiza um
            Congresso Nacional e, entre um nacional e outro, dois Congressos Regionais, alternados
            entre o Sudeste (Rio de Janeiro e Minas Gerais) e o Sul (Paraná, Santa Catarina e Rio
            Grande do Sul).
          </p>
          <p>
            O presidente é {diretoria.executiva[0].nome}, maestro dos Pequenos Cantores de Passos.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── CONGRESSOS ──────────────────────────────────────────────────────────
      Relação enviada pela federação em novembro de 2026, com as fontes
      anotadas em src/config/federacao.ts. */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">Congressos</h2>

    <p class="medida mt-6 text-lg leading-relaxed text-tinta-suave">
      O congresso nacional é o encontro que dá forma à federação: os coros se hospedam nas paróquias
      da cidade anfitriã e cantam juntos ao fim de alguns dias de ensaio. Acontece de três em três
      anos.
    </p>

    <div class="mt-14 grid gap-14 md:grid-cols-3 md:gap-12">
      <div>
        <h3 class="text-xl">Nacionais</h3>

        <ul class="mt-6">
          {
            congressosNacionais.map((c) => (
              <li class="border-t border-papel-borda py-5">
                <p class="flex flex-wrap items-baseline gap-x-4">
                  <span data-numerico class="font-display text-3xl leading-none">{c.ano}</span>
                  <span class="text-tinta-suave">{c.edicao} Congresso Nacional</span>
                </p>
                <p class="mt-2 text-sm text-tinta-suave">{c.local}</p>
                {c.nota && (
                  <p class="mt-2 text-sm text-tinta-tenue">
                    {c.futuro && <span class="text-acento-profundo">Ainda por vir. </span>}
                    {c.nota}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xl">O Brasil nos internacionais</h3>

        <ul class="mt-6">
          {
            congressosInternacionais.map((c) => (
              <li class="border-t border-papel-borda py-5">
                <p class="flex flex-wrap items-baseline gap-x-4">
                  <span data-numerico class="font-display text-3xl leading-none">{c.ano}</span>
                  <span class="text-tinta-suave">
                    {c.edicao ? `${c.edicao} Congresso Internacional` : 'Congresso Internacional'}
                  </span>
                </p>
                <p class="mt-2 text-sm text-tinta-suave">{c.local}</p>
                {c.nota && <p class="mt-2 text-sm text-tinta-tenue">{c.nota}</p>}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xl">Regionais</h3>

        <ul class="mt-6">
          {
            congressosRegionais.map((c) => (
              <li class="border-t border-papel-borda py-5">
                <p class="font-display text-3xl leading-none">{c.ano}</p>
                <p class="mt-2 text-sm text-tinta-suave">{c.local}</p>
                {c.nota && <p class="mt-2 text-sm text-tinta-tenue">{c.nota}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

  </section>

  {/* ── PRÓXIMOS ENCONTROS ───────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">Próximos encontros</h2>

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        congressosFuturos.map((c) => (
          <li class="border-t border-papel-borda py-5">
            <p class="font-display text-3xl leading-none">{c.ano}</p>
            <p class="mt-2 text-lg">{c.local}</p>
            {c.nota && <p class="mt-2 text-sm leading-relaxed text-tinta-tenue">{c.nota}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  {/* ── DIRETORIA ───────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" data-fio-scroll aria-hidden="true"></span>

    <h2 class="mt-10 text-(length:--text-secao)">Diretoria</h2>

    <p class="mt-4 text-sm text-tinta-tenue">Mandato: {diretoria.mandato}.</p>

    <div class="mt-10 grid gap-12 md:grid-cols-2">
      <div>
        <h3 class="text-xl">Diretoria executiva</h3>
        <ul class="mt-6 grid gap-5 sm:grid-cols-2">
          {diretoria.executiva.map((pessoa) => (
            <li>
              <p class="font-display text-2xl leading-tight">{pessoa.nome}</p>
              <p class="mt-1 text-sm text-tinta-tenue">{pessoa.cargo}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xl">Conselho Fiscal</h3>
        <p class="mt-6 text-sm uppercase tracking-[0.12em] text-tinta-tenue">Titulares</p>
        <ul class="mt-3 space-y-2">
          {diretoria.conselhoFiscal.titulares.map((nome) => <li>{nome}</li>)}
        </ul>
        <p class="mt-6 text-sm uppercase tracking-[0.12em] text-tinta-tenue">Suplentes</p>
        <ul class="mt-3 space-y-2">
          {diretoria.conselhoFiscal.suplentes.map((nome) => <li>{nome}</li>)}
        </ul>
      </div>
    </div>

  </section>

  {/* ── CHAMADAS ────────────────────────────────────────────────────────── */}
  <section class="quadro pb-(--spacing-secao)">
    <span class="fio" aria-hidden="true"></span>

    <div class="mt-10 flex flex-wrap items-center gap-10">
      <Brasao tamanho={88} titulo="" />

      <div class="flex flex-wrap gap-x-10 gap-y-4">
        <a
          href={rota('/corais')}
          class="border-b border-acento pb-1 text-lg transition-colors hover:text-acento-profundo"
        >
          Os {totalCorais} corais filiados
        </a>
        <a
          href={rota('/filiacao')}
          class="border-b border-transparent pb-1 text-lg text-tinta-suave transition-colors hover:border-papel-borda hover:text-tinta"
        >
          Como se filiar
        </a>
      </div>
    </div>
  </section>
</Base>
