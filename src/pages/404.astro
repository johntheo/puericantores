---
/**
 * Uma 404 só, para os três idiomas: o Firebase serve um único `404.html` para
 * qualquer endereço quebrado, e quem chega aqui pode falar qualquer um deles.
 * As mensagens vêm empilhadas, cada uma no seu idioma e marcada com `lang`.
 */
import Base from '~/layouts/Base.astro';
import { rota } from '~/config/site';
import { dicionarios } from '~/i18n';
import { idiomas, dadosIdioma } from '~/i18n/idiomas';
---

<Base titulo={dicionarios.pt.erro404.titulo} indexar={false}>
  <section class="quadro flex min-h-[70svh] flex-col justify-center gap-12 py-24">
    {
      idiomas.map((i) => (
        <div lang={dadosIdioma[i].html}>
          {i === 'pt' ? (
            <h1 class="text-(length:--text-titulo)">{dicionarios[i].erro404.titulo}</h1>
          ) : (
            <p class="font-display text-(length:--text-secao)">{dicionarios[i].erro404.titulo}</p>
          )}
          <p class="mt-3 text-tinta-suave">{dicionarios[i].erro404.texto}</p>
          <p class="mt-4">
            <a href={rota('/', i)} class="border-b border-acento pb-1 transition-colors hover:text-acento-profundo">
              {dicionarios[i].erro404.voltar}
            </a>
          </p>
        </div>
      ))
    }
  </section>
</Base>
